{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parrot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "parrot-audio" }],
  "vars": {
    // Fill these in after creating the Cloudflare Access application (see README).
    // The API refuses all requests while they are empty.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
