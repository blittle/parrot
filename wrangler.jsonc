{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parrot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "parrot-audio" }],
  // Served at parrot.<subdomain>.workers.dev. Preview URLs are off so there is
  // no second address that Cloudflare Access might not cover.
  "workers_dev": true,
  "preview_urls": false,
  // No "vars": ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS and
  // GOOGLE_TTS_API_KEY are all Worker secrets (`wrangler secret put`), so
  // deploys from CI never overwrite them. The API fails closed until they're set.
  "observability": { "enabled": true }
}
